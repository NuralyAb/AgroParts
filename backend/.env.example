# Скопируйте в .env и при необходимости измените. Все переменные с префиксом AGRO_.

# Локально — SQLite (по умолчанию). Для PostgreSQL из docker-compose.yml:
# AGRO_DATABASE_URL=postgresql+psycopg://agro:agro@localhost:5432/agroparts
AGRO_DATABASE_URL=sqlite:///./agroparts.db

# Обязательно сменить в production
AGRO_JWT_SECRET=dev-secret-change-me

# Сколько держится резерв неподтверждённого онлайн-заказа (мин) и подтверждённой брони (ч)
AGRO_PENDING_ORDER_TTL_MINUTES=120
AGRO_CONFIRMED_HOLD_HOURS=48
